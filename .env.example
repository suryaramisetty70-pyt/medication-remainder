# PostgreSQL connection (Render provides this automatically as DATABASE_URL
# for a linked Render Postgres instance — copy the "Internal Database URL")
DATABASE_URL=postgresql://user:password@localhost:5432/medreminder

# JWT
SECRET_KEY=change-this-to-a-long-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# SMTP (for emergency missed-dose alerts)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-app@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM_NAME=Smart Medication Reminder

# CORS - comma separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173,https://your-frontend.onrender.com
